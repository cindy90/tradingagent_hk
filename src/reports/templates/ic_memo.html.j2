{# IC Memo HTML 模板 - 真投行 IC memo 干货风格

设计原则:
- 信息密度优先，去掉 emoji 装饰
- 参考 GS / MS / 中金 实际 IC memo 的视觉:
  * 单色调（灰阶 + 极少 accent 色）
  * 表格密度高
  * 章节用罗马数字 / 大写
  * 关键数字粗体而非彩色
  * 颜色仅用于"关键状态指示"（推荐档/情景/严重度），不滥用
- 完全自包含 (内联 CSS, 0 外部依赖)
#}<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IC Memo · {{ ctx.company_name }} ({{ ctx.ticker }})</title>
<style>
:root {
  --bg: #ffffff;
  --paper: #ffffff;
  --border: #d1d5db;
  --border-light: #e5e7eb;
  --text: #111827;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --accent: #1e3a5f;
  --accent-light: #f1f5f9;
  --green: #059669;
  --green-bg: #ecfdf5;
  --red: #b91c1c;
  --red-bg: #fef2f2;
  --orange: #b45309;
  --orange-bg: #fff7ed;
  --yellow: #a16207;
  --yellow-bg: #fefce8;
  --neutral: #6b7280;
  --neutral-bg: #f3f4f6;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", Georgia, "PingFang SC",
               "Microsoft YaHei", "Segoe UI", sans-serif;
  font-size: 13px;
  line-height: 1.7;
  color: var(--text);
}
.container { max-width: 980px; margin: 0 auto; padding: 36px 32px 60px; }

/* Header — 简洁分隔条 */
.doc-header {
  border-bottom: 2px solid var(--text);
  padding-bottom: 16px;
  margin-bottom: 28px;
}
.doc-header .doc-type {
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 4px;
}
.doc-header h1 {
  margin: 0 0 6px 0;
  font-size: 20px;
  font-weight: 600;
  font-family: "Source Han Sans SC", "Noto Sans CJK SC", -apple-system, sans-serif;
}
.doc-header .meta {
  font-size: 12px;
  color: var(--text-muted);
  font-family: -apple-system, sans-serif;
}
.doc-header .meta span { margin-right: 18px; }

/* 章节 */
section.chapter {
  margin: 28px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--border-light);
}
section.chapter:first-of-type { border-top: none; padding-top: 0; }
h2 {
  font-size: 15px;
  font-weight: 600;
  margin: 0 0 12px 0;
  color: var(--accent);
  font-family: "Source Han Sans SC", "Noto Sans CJK SC", sans-serif;
}
h3 {
  font-size: 13px;
  font-weight: 600;
  margin: 16px 0 6px 0;
  color: var(--text-secondary);
}

/* Executive Summary — 单表格紧凑展示 */
table.exec-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin-bottom: 16px;
}
table.exec-table tr { border-bottom: 1px solid var(--border-light); }
table.exec-table th {
  text-align: left;
  font-weight: 500;
  color: var(--text-muted);
  padding: 8px 16px 8px 0;
  width: 130px;
  vertical-align: top;
}
table.exec-table td {
  padding: 8px 0;
  font-weight: 500;
}
table.exec-table td.highlight {
  font-size: 16px;
  font-weight: 600;
}
table.exec-table td.highlight.rec-认购     { color: var(--green); }
table.exec-table td.highlight.rec-审慎参与 { color: var(--orange); }
table.exec-table td.highlight.rec-观望     { color: var(--neutral); }
table.exec-table td.highlight.rec-不认购   { color: var(--red); }

/* 普通表格 */
table.data {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
  margin: 8px 0;
}
table.data th, table.data td {
  padding: 7px 10px;
  text-align: left;
  border-bottom: 1px solid var(--border-light);
  vertical-align: top;
}
table.data thead th {
  background: var(--neutral-bg);
  font-weight: 600;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-secondary);
  border-bottom: 2px solid var(--border);
}
table.data tbody tr:hover td { background: var(--accent-light); }

/* 敏感性 — 仅左边色条标识情景 */
tr.scenario-悲观 td:first-child { border-left: 3px solid var(--red); padding-left: 8px; }
tr.scenario-基准 td:first-child { border-left: 3px solid var(--neutral); padding-left: 8px; }
tr.scenario-乐观 td:first-child { border-left: 3px solid var(--green); padding-left: 8px; }

/* 列表 */
ul.tight {
  list-style: none;
  padding: 0;
  margin: 6px 0;
}
ul.tight li {
  padding: 4px 0 4px 20px;
  position: relative;
  border-bottom: 1px dashed var(--border-light);
  font-size: 13px;
}
ul.tight li:last-child { border-bottom: none; }
ul.tight li::before {
  content: "—";
  position: absolute;
  left: 0;
  color: var(--text-muted);
}

/* Two-column blocks */
.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin: 8px 0;
}
@media (max-width: 720px) { .two-col { grid-template-columns: 1fr; } }

/* Kill switches — 表格化, 不用 alert box */
table.kill-switches td.severity {
  font-weight: 600;
  width: 50px;
}
table.kill-switches td.severity.severity-高 { color: var(--red); }
table.kill-switches td.severity.severity-中 { color: var(--orange); }
table.kill-switches td.severity.severity-低 { color: var(--yellow); }

/* Reasoning chain */
.reasoning-step {
  border-left: 2px solid var(--border);
  padding: 4px 0 4px 14px;
  margin: 14px 0;
}
.reasoning-step .rs-num {
  display: inline-block;
  font-weight: 600;
  color: var(--accent);
  margin-right: 6px;
  font-family: -apple-system, sans-serif;
}
.reasoning-step .rs-title {
  font-weight: 600;
  font-size: 13.5px;
  margin-bottom: 6px;
}
.reasoning-step .rs-conf {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 2px;
  font-size: 10.5px;
  font-weight: 500;
  margin-left: 8px;
  font-family: -apple-system, sans-serif;
  letter-spacing: 0.3px;
}
.reasoning-step .rs-conf.conf-高 { background: var(--green-bg); color: var(--green); border: 1px solid var(--green); }
.reasoning-step .rs-conf.conf-中 { background: var(--neutral-bg); color: var(--neutral); border: 1px solid var(--border); }
.reasoning-step .rs-conf.conf-低 { background: var(--red-bg); color: var(--red); border: 1px solid var(--red); }
.reasoning-step dl {
  margin: 4px 0 0 0;
  font-size: 12.5px;
}
.reasoning-step dt {
  display: inline-block;
  width: 80px;
  font-weight: 500;
  color: var(--text-muted);
  vertical-align: top;
  font-size: 12px;
}
.reasoning-step dd {
  display: inline-block;
  width: calc(100% - 90px);
  margin: 0 0 4px 0;
  vertical-align: top;
}
.reasoning-step dd code,
.reasoning-step dd .calc {
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 12px;
  background: var(--neutral-bg);
  padding: 1px 5px;
  border-radius: 2px;
}
.reasoning-step .rs-caveats {
  font-size: 12px;
  color: var(--orange);
  margin-top: 8px;
  padding: 6px 10px;
  background: var(--orange-bg);
  border-left: 2px solid var(--orange);
  font-style: italic;
}

/* 决策因子加权打分 */
table.factor-weights {
  font-size: 12.5px;
}
table.factor-weights td.f-name { font-weight: 600; color: var(--accent); width: 130px; }
table.factor-weights td.f-weight { width: 60px; text-align: right; font-family: ui-monospace, monospace; }
table.factor-weights td.f-score  { width: 60px; text-align: right; font-family: ui-monospace, monospace; }
table.factor-weights td.f-contrib {
  width: 140px;
  font-family: ui-monospace, monospace;
}
table.factor-weights td.f-contrib .bar {
  display: inline-block;
  width: 70px;
  height: 7px;
  background: var(--border-light);
  border-radius: 1px;
  vertical-align: middle;
  margin-right: 6px;
  overflow: hidden;
}
table.factor-weights td.f-contrib .bar > span {
  display: block;
  height: 100%;
  background: var(--accent);
}
table.factor-weights td.f-rationale {
  font-size: 12px;
  color: var(--text-muted);
}
table.factor-weights tr.weighted-total td {
  border-top: 2px solid var(--text);
  font-weight: 600;
  background: var(--accent-light);
  padding-top: 10px;
  padding-bottom: 10px;
}
table.factor-weights tr.weighted-total td.f-contrib {
  font-size: 14px;
}
.weight-warn {
  color: var(--orange);
  font-size: 11px;
  font-weight: 500;
  margin-left: 4px;
}
.mapping-legend {
  font-size: 11.5px;
  color: var(--text-muted);
  margin: 6px 0 0;
  font-family: -apple-system, sans-serif;
}
.mapping-legend code {
  background: var(--neutral-bg);
  padding: 1px 6px;
  border-radius: 2px;
  font-size: 11px;
  margin: 0 2px;
}

/* 估值方法分拆 */
.method-row {
  display: grid;
  grid-template-columns: 70px 1fr 90px 50px;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-light);
  font-size: 12.5px;
}
.method-row:last-child { border-bottom: none; }
.method-row .m-name { font-weight: 600; color: var(--accent); }
.method-row .m-detail dt { display: inline-block; width: 70px; color: var(--text-muted); font-size: 11.5px; }
.method-row .m-detail dd { display: inline-block; margin: 0; font-size: 12px; }
.method-row .m-detail .formula { font-family: ui-monospace, monospace; font-size: 11.5px; }
.method-row .m-result { font-weight: 600; text-align: right; }
.method-row .m-weight { font-size: 11px; color: var(--text-muted); text-align: right; }

/* 假设清单 */
ol.assumptions {
  padding-left: 24px;
  margin: 8px 0;
  font-size: 13px;
}
ol.assumptions li {
  padding: 4px 0;
  border-bottom: 1px dashed var(--border-light);
}

/* Tooltip on figures */
.fig-with-rationale {
  cursor: help;
  border-bottom: 1px dotted var(--text-muted);
  position: relative;
}
.fig-with-rationale:hover::after {
  content: attr(data-rationale);
  position: absolute;
  bottom: calc(100% + 4px);
  left: 0;
  background: var(--text);
  color: white;
  padding: 6px 10px;
  border-radius: 3px;
  font-size: 11.5px;
  white-space: pre-wrap;
  width: max-content;
  max-width: 380px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  z-index: 100;
  font-weight: normal;
  line-height: 1.5;
  font-family: "Source Han Sans SC", sans-serif;
}

/* 决议正文 */
.narrative {
  font-size: 13px;
  line-height: 1.85;
}
.narrative h2 {
  font-size: 14px;
  margin-top: 22px;
  border-bottom: 1px solid var(--border-light);
  padding-bottom: 4px;
}
.narrative h3 { font-size: 13px; margin-top: 14px; color: var(--text-secondary); }
.narrative p { margin: 8px 0; }
.narrative table {
  font-size: 12px;
  border-collapse: collapse;
  margin: 8px 0;
}
.narrative table th, .narrative table td {
  padding: 6px 10px;
  border: 1px solid var(--border-light);
}
.narrative blockquote {
  border-left: 2px solid var(--text-muted);
  margin: 8px 0;
  padding: 4px 12px;
  color: var(--text-muted);
  background: var(--neutral-bg);
}

/* Brief 折叠 */
details.brief {
  border: 1px solid var(--border-light);
  border-radius: 3px;
  margin: 6px 0;
  font-size: 12.5px;
}
details.brief > summary {
  cursor: pointer;
  padding: 8px 12px;
  font-weight: 500;
  color: var(--text-secondary);
  user-select: none;
  background: var(--neutral-bg);
}
details.brief > summary:hover { background: var(--accent-light); }
details.brief[open] > summary {
  border-bottom: 1px solid var(--border-light);
  color: var(--accent);
}
details.brief .brief-body {
  padding: 12px 14px;
  font-size: 12.5px;
  line-height: 1.7;
}

/* Footer */
footer {
  margin-top: 36px;
  padding-top: 14px;
  border-top: 1px solid var(--border-light);
  font-size: 11px;
  color: var(--text-muted);
  text-align: center;
  font-family: -apple-system, sans-serif;
}
footer code { background: var(--neutral-bg); padding: 1px 4px; border-radius: 2px; font-size: 11px; }

/* Print */
@media print {
  body { background: white; }
  .container { padding: 16px; max-width: none; }
  details.brief[open] .brief-body { display: block !important; }
  details.brief { page-break-inside: avoid; }
}

/* 子工具样式 */
.note { font-size: 11.5px; color: var(--text-muted); font-style: italic; margin: 4px 0; }
.label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
.muted { color: var(--text-muted); }
</style>
</head>
<body>
<div class="container">

<!-- HEADER -->
<div class="doc-header">
  <div class="doc-type">Cornerstone Investment · IC Memo</div>
  <h1>{{ ctx.company_name }} ({{ ctx.ticker }})</h1>
  <div class="meta">
    <span>行业: {{ ctx.industry }}</span>
    <span>项目编号: {{ ctx.project_id }}</span>
    <span>生成时间: {{ generated_at }}</span>
  </div>
</div>

<!-- 0. LISTING PROFILE (only if known) -->
{% set profile = ctx.extras.listing_profile if ctx.extras.listing_profile else None %}
{% if profile and profile.listing_chapter and profile.listing_chapter != 'Unknown' %}
<section class="chapter">
  <h2>0. 上市档案 (Listing Profile)</h2>
  <table class="exec-table">
    <tr><th>上市规则章节</th><td><strong>{{ profile.listing_chapter }}</strong></td></tr>
    <tr><th>盈利阶段</th><td>{{ profile.profitability_stage }}</td></tr>
    <tr><th>规模档</th><td>{{ profile.size_tier }}</td></tr>
    <tr><th>行业主题</th><td>{{ profile.industry_theme }}</td></tr>
    {% if profile.has_wvr %}
    <tr><th>同股不同权 (WVR)</th><td><strong style="color: var(--orange);">是</strong></td></tr>
    {% endif %}
    {% if profile.has_a_share_listed %}
    <tr><th>A 股已上市</th><td>是（代码 {{ profile.a_share_ticker or '未知' }}）</td></tr>
    {% endif %}
    {% if profile.is_concept_stock %}
    <tr><th>中概股</th><td>是</td></tr>
    {% endif %}
    {% if profile.main_listing_market %}
    <tr><th>主上市地（二次上市）</th><td>{{ profile.main_listing_market }}</td></tr>
    {% endif %}
    <tr><th>档案推断置信度</th><td class="muted">{{ profile.detection_confidence }}</td></tr>
  </table>
  <p class="note">
    决定下游 Agent 的差异化处理: 估值方法选择 / 决策因子权重区间 / 风险维度增补
  </p>
</section>
{% endif %}

<!-- I. EXECUTIVE SUMMARY -->
<section class="chapter">
  <h2>I. 投决摘要</h2>
  <table class="exec-table">
    <tr>
      <th>最终建议</th>
      <td class="highlight rec-{{ d.get('recommendation', '观望') }}">{{ d.get('recommendation', '—') }}</td>
    </tr>
    <tr><th>置信度</th><td>{{ d.get('confidence', '—') }}</td></tr>
    <tr><th>定价观点</th><td>{{ d.get('ipo_pricing_view', '—') }}</td></tr>
    <tr>
      <th>估值区间</th>
      <td>
        <strong>{{ valuation.get('mid', '—') }} 亿 HKD</strong>
        <span class="muted">
          (区间 {{ valuation.get('low', '—') }} ~ {{ valuation.get('high', '—') }} ·
          锚定方法: {{ valuation.get('anchor_method', '—') }})
        </span>
      </td>
    </tr>
    <tr>
      <th>建议金额</th>
      <td>
        {% if amounts and amounts|length >= 2 %}
          <strong>{{ amounts[0] }} ~ {{ amounts[1] }} M USD</strong>
        {% else %}—{% endif %}
      </td>
    </tr>
  </table>
</section>

<!-- II. KEY SUPPORTS / RISKS -->
<section class="chapter">
  <div class="two-col">
    <div>
      <h2>II.A 关键支持</h2>
      {% if d.get('key_supports') %}
      <ul class="tight">
        {% for s in d.get('key_supports', []) %}<li>{{ s }}</li>{% endfor %}
      </ul>
      {% else %}<p class="muted">（无）</p>{% endif %}
    </div>
    <div>
      <h2>II.B 核心风险</h2>
      {% if d.get('key_risks') %}
      <ul class="tight">
        {% for r in d.get('key_risks', []) %}<li>{{ r }}</li>{% endfor %}
      </ul>
      {% else %}<p class="muted">（无）</p>{% endif %}
    </div>
  </div>
</section>

<!-- III. KEY ASSUMPTIONS -->
{% if d.get('key_assumptions') %}
<section class="chapter">
  <h2>III. 投决依赖的核心假设</h2>
  <p class="note">下列假设任一被颠覆, 决议需重新评估。可作为持续监控的"假设监控表"。</p>
  <ol class="assumptions">
    {% for a in d.get('key_assumptions', []) %}<li>{{ a }}</li>{% endfor %}
  </ol>
</section>
{% endif %}

<!-- IV. VALUATION METHODOLOGY -->
{% set vm = valuation.get('methodology_breakdown') %}
{% if vm %}
<section class="chapter">
  <h2>IV. 估值方法分拆</h2>
  <p class="note">
    锚定方法: <strong>{{ valuation.get('anchor_method', '—') }}</strong>
    {% if valuation.get('anchor_logic') %} · 逻辑: {{ valuation.get('anchor_logic', '') }}{% endif %}
  </p>
  <div>
    {% for m in vm %}
    <div class="method-row">
      <div class="m-name">{{ m.get('method', '—') }}</div>
      <div class="m-detail">
        <dl>
          <dt>可比基准</dt><dd>{{ m.get('peer_basis', '—') }}</dd><br>
          <dt>目标指标</dt><dd>{{ m.get('target_metric', '—') }}</dd><br>
          <dt>计算公式</dt><dd><span class="formula">{{ m.get('formula', '—') }}</span></dd>
        </dl>
      </div>
      <div class="m-result">
        {% if m.get('result_hkd_b') is not none %}{{ m.get('result_hkd_b') }} 亿 HKD{% else %}—{% endif %}
      </div>
      <div class="m-weight">
        {% if m.get('weight') is not none %}权重 {{ (m.get('weight', 0) * 100) | round(0) | int }}%{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% if valuation.get('key_assumptions') %}
  <h3>本估值依赖的关键假设</h3>
  <ul class="tight">
    {% for a in valuation.get('key_assumptions', []) %}<li>{{ a }}</li>{% endfor %}
  </ul>
  {% endif %}
</section>
{% endif %}

<!-- V. SENSITIVITY -->
<section class="chapter">
  <h2>V. 敏感性分析（三档情景）</h2>
  <p class="note">"估值"和"概率"列鼠标悬停可查看推算逻辑。</p>
  {% if d.get('sensitivity_table') %}
  <table class="data">
    <thead>
      <tr>
        <th style="width: 60px;">情景</th>
        <th>触发条件</th>
        <th style="width: 110px;">估值 (亿 HKD)</th>
        <th style="width: 80px;">概率</th>
        <th style="width: 90px;">预期回报</th>
      </tr>
    </thead>
    <tbody>
    {% for s in d.get('sensitivity_table', []) %}
      <tr class="scenario-{{ s.get('name', '') }}">
        <td><strong>{{ s.get('name', '') }}</strong></td>
        <td>{{ s.get('triggers', []) | join('; ') }}</td>
        <td>
          {% set vd = s.get('valuation_derivation', '') %}
          {% if vd %}
            <span class="fig-with-rationale" data-rationale="推算: {{ vd }}">
              <strong>{{ s.get('valuation_hkd_b', '—') }}</strong>
            </span>
          {% else %}<strong>{{ s.get('valuation_hkd_b', '—') }}</strong>{% endif %}
        </td>
        <td>
          {% set p = s.get('probability', 0) %}
          {% set pr = s.get('probability_rationale', '') %}
          {% if pr %}
            <span class="fig-with-rationale" data-rationale="赋值依据: {{ pr }}">
              {{ (p * 100) | round(0) | int }}%
            </span>
          {% else %}{{ (p * 100) | round(0) | int }}%{% endif %}
        </td>
        <td>
          {% set r = s.get('expected_return_pct') %}
          {% if r is not none %}
            <strong style="color: {% if r > 0 %}var(--green){% elif r < 0 %}var(--red){% else %}var(--text-muted){% endif %};">
              {{ '+' if r > 0 else '' }}{{ '%.1f'|format(r) }}%
            </strong>
          {% else %}—{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="muted">（敏感性分析缺失）</p>{% endif %}
</section>

<!-- VI. DECISION WEIGHTS — 决策因子加权打分卡 -->
{% if d.get('decision_weights') %}
<section class="chapter">
  <h2>VI. 决策因子加权打分</h2>
  {% set total = d.get('weighted_total_score') %}
  {% set mapping = d.get('weighted_to_recommendation_mapping') %}
  {% set factors = d.get('decision_weights', []) %}
  {% set weight_sum = factors | sum(attribute='weight') if factors and factors[0] is mapping else 0 %}
  {# pydantic dump 后 list[dict], 用 namespace 兼容 #}
  {% set ns = namespace(wsum=0.0) %}
  {% for f in factors %}{% set ns.wsum = ns.wsum + (f.get('weight', 0) | float) %}{% endfor %}
  <p class="mapping-legend">
    映射区间:
    <code>≥4.0 认购</code>
    <code>3.0-4.0 审慎参与</code>
    <code>2.0-3.0 观望</code>
    <code>&lt;2.0 不认购</code>
  </p>
  <table class="data factor-weights">
    <thead>
      <tr>
        <th>因子</th>
        <th style="width: 60px; text-align: right;">权重</th>
        <th style="width: 60px; text-align: right;">得分</th>
        <th style="width: 140px;">贡献 (权重×得分)</th>
        <th>权重 + 得分理由</th>
        <th style="width: 130px;">数据源</th>
      </tr>
    </thead>
    <tbody>
    {% for f in factors %}
      {% set w = f.get('weight', 0) | float %}
      {% set s = f.get('score', 0) | float %}
      {% set c = f.get('contribution', 0) | float %}
      {% if c == 0 and (w * s) != 0 %}{% set c = w * s %}{% endif %}
      <tr>
        <td class="f-name">{{ f.get('factor', '—') }}</td>
        <td class="f-weight">{{ (w * 100) | round(0) | int }}%</td>
        <td class="f-score">{{ '%.1f'|format(s) }}</td>
        <td class="f-contrib">
          <span class="bar"><span style="width: {{ (c / 5 * 100) | round(0) | int }}%;"></span></span>
          <strong>{{ '%.2f'|format(c) }}</strong>
        </td>
        <td class="f-rationale">{{ f.get('rationale', '—') }}</td>
        <td class="muted" style="font-size: 11.5px;">
          {{ (f.get('source_agents', []) | join(', ')) or '—' }}
        </td>
      </tr>
    {% endfor %}
      <tr class="weighted-total">
        <td>加权总分</td>
        <td class="f-weight">
          {{ (ns.wsum * 100) | round(0) | int }}%
          {% if ns.wsum < 0.92 or ns.wsum > 1.08 %}
            <span class="weight-warn">⚠ 偏离 1.0</span>
          {% endif %}
        </td>
        <td class="f-score">—</td>
        <td class="f-contrib">
          {% if total is not none %}
            <span class="bar"><span style="width: {{ (total / 5 * 100) | round(0) | int }}%; background: var(--text);"></span></span>
            <strong style="font-size: 14px;">{{ '%.2f'|format(total) }}</strong>
            <span class="muted" style="font-size: 11.5px;"> / 5.0</span>
          {% else %}—{% endif %}
        </td>
        <td colspan="2" class="muted">
          {{ mapping or '—' }}
        </td>
      </tr>
    </tbody>
  </table>
</section>
{% endif %}

<!-- VII. REASONING CHAIN -->
{% if d.get('reasoning_chain') %}
<section class="chapter">
  <h2>VII. 推理链（论证流溯源）</h2>
  <p class="note">
    把"从 Agent 简报推到最终建议"的链条显式化, 让每个量化结论可 trace 到具体推理步骤。
  </p>
  {% for step in d.get('reasoning_chain', []) %}
  <div class="reasoning-step">
    <div class="rs-title">
      <span class="rs-num">[{{ step.get('step_no', loop.index) }}]</span>
      {{ step.get('title', '—') }}
      <span class="rs-conf conf-{{ step.get('confidence', '中') }}">{{ step.get('confidence', '中') }}置信</span>
    </div>
    <dl>
      {% if step.get('premise') %}<dt>前提</dt><dd>{{ step.get('premise') }}</dd><br>{% endif %}
      {% if step.get('data_source') %}<dt>数据来源</dt><dd>{{ step.get('data_source') }}</dd><br>{% endif %}
      {% if step.get('calculation') %}<dt>计算</dt><dd><span class="calc">{{ step.get('calculation') }}</span></dd><br>{% endif %}
      {% if step.get('conclusion') %}<dt>结论</dt><dd><strong>{{ step.get('conclusion') }}</strong></dd>{% endif %}
    </dl>
    {% if step.get('caveats') %}
      <div class="rs-caveats">
        异议/依赖: {% for cv in step.get('caveats', []) %}{% if not loop.first %}; {% endif %}{{ cv }}{% endfor %}
      </div>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

<!-- VII. HEDGING + EXIT -->
<section class="chapter">
  <div class="two-col">
    <div>
      <h2>VIII.A 对冲策略</h2>
      {% if hedging %}
      <table class="exec-table">
        <tr><th>工具</th><td>{{ hedging.get('instrument', '—') }}</td></tr>
        <tr><th>覆盖比例</th><td>
          {% set cov = hedging.get('target_coverage_pct') %}
          {% if cov is not none %}{{ (cov * 100) | round(0) | int }}% (名义本金占比){% else %}—{% endif %}
        </td></tr>
        <tr><th>理由</th><td class="muted">{{ hedging.get('rationale', '—') }}</td></tr>
      </table>
      {% else %}<p class="muted">（未提供对冲策略）</p>{% endif %}
    </div>
    <div>
      <h2>VIII.B 退出策略</h2>
      {% if exit_plan %}
      <table class="exec-table">
        <tr><th>退出时点</th><td>{{ exit_plan.get('horizon', '—') }}</td></tr>
        <tr><th>方式 / 节奏</th><td>{{ exit_plan.get('method', '—') }} · {{ exit_plan.get('pace', '—') }}</td></tr>
        <tr><th>提前减持触发</th><td>
          {% set tcs = exit_plan.get('trigger_conditions', []) %}
          {% if tcs %}
            <ul class="tight" style="margin: 0;">{% for t in tcs %}<li>{{ t }}</li>{% endfor %}</ul>
          {% else %}<span class="muted">无</span>{% endif %}
        </td></tr>
      </table>
      {% else %}<p class="muted">（未提供退出策略）</p>{% endif %}
    </div>
  </div>
</section>

<!-- VIII. KILL SWITCHES -->
<section class="chapter">
  <h2>IX. Kill Switches（认购后退出触发）</h2>
  {% if d.get('kill_switches') %}
  <table class="data kill-switches">
    <thead>
      <tr>
        <th style="width: 50px;">严重度</th>
        <th>触发事件</th>
        <th style="width: 200px;">动作</th>
        <th>阈值依据</th>
      </tr>
    </thead>
    <tbody>
    {% for ks in d.get('kill_switches', []) %}
      <tr>
        <td class="severity severity-{{ ks.get('severity', '中') }}">{{ ks.get('severity', '中') }}</td>
        <td><strong>{{ ks.get('trigger', '—') }}</strong></td>
        <td>{{ ks.get('action', '—') }}</td>
        <td class="muted">
          {{ ks.get('rationale', '—') }}
          {% if ks.get('historical_precedent') %}
          <br><span style="font-size: 11px;">历史案例: {{ ks.get('historical_precedent') }}</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="muted">（未提供 kill switches）</p>{% endif %}
</section>

<!-- IX. MONITORING KPIs -->
<section class="chapter">
  <h2>X. 监控 KPI</h2>
  {% if d.get('monitoring_kpis_detailed') %}
  <table class="data">
    <thead>
      <tr><th>KPI</th><th style="width: 80px;">阈值</th><th style="width: 70px;">频率</th><th>违阈动作</th><th>阈值依据</th></tr>
    </thead>
    <tbody>
    {% for k in d.get('monitoring_kpis_detailed', []) %}
      <tr>
        <td><strong>{{ k.get('name', '—') }}</strong></td>
        <td>
          {% set tr = k.get('threshold_rationale', '') %}
          {% set ib = k.get('industry_benchmark', '') %}
          {% if tr or ib %}
            <span class="fig-with-rationale" data-rationale="{{ tr }}{% if ib %}{{ '\n行业基准: ' + ib }}{% endif %}">
              <code>{{ k.get('threshold', '—') }}</code>
            </span>
          {% else %}<code>{{ k.get('threshold', '—') }}</code>{% endif %}
        </td>
        <td>{{ k.get('frequency', '—') }}</td>
        <td class="muted">{{ k.get('action_if_breach', '—') }}</td>
        <td class="muted" style="font-size: 11.5px;">{{ k.get('threshold_rationale', '—') }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% elif d.get('monitoring_kpis') %}
  <ul class="tight">{% for k in d.get('monitoring_kpis', []) %}<li>{{ k }}</li>{% endfor %}</ul>
  {% else %}<p class="muted">（未提供监控 KPI）</p>{% endif %}
</section>

<!-- X. DEAL CONDITIONS -->
{% if d.get('deal_conditions') %}
<section class="chapter">
  <h2>XI. 硬性认购条件</h2>
  <ul class="tight">
    {% for c in d.get('deal_conditions', []) %}<li>{{ c }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

<!-- XI. DECISION NARRATIVE -->
<section class="chapter">
  <h2>XII. 决议全文</h2>
  <div class="narrative">{{ decision_html | safe }}</div>
</section>

<!-- XII. AGENT BRIEFS -->
<section class="chapter">
  <h2>XIII. 各环节简报合集</h2>
  <p class="note">默认折叠, 点击章节展开。</p>
  {% for name, brief_html in briefs %}
  <details class="brief">
    <summary>{{ agent_label(name) }}</summary>
    <div class="brief-body">{{ brief_html | safe }}</div>
  </details>
  {% endfor %}
</section>

<footer>
  生成时间 {{ generated_at }} ·
  详细分项报告见同目录 <code>FINAL_MEMO.md</code> 及 <code>0X_*.md</code> ·
  完整决议 JSON 见 <code>09_decision.md</code>
</footer>

</div></body></html>
