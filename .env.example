# LLM Provider 选择 (anthropic | kimi | deepseek)
LLM_PROVIDER=kimi

# 各家 API Key（按 LLM_PROVIDER 选用）
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型 tier 覆盖（可选；不填用 src/llm/router.py 内置默认）
# 通用：MODEL_TIER_SUMMARIZE / MODEL_TIER_ANALYZE / MODEL_TIER_DECIDE
# 按 provider 覆盖：MODEL_TIER_<TIER>_<PROVIDER> 如 MODEL_TIER_DECIDE_KIMI=kimi-latest

# ============================================================================
# 同花顺 iFinD（可选，未配置时回退到 akshare）
# 文档: https://quantapi.10jqka.com.cn/gwstatic/static/ds_web/quantapi-web/
#
# 项目同时使用 iFinD 的两套接口（**同一个 iFinD 账号**），但鉴权方式不同：
#
#   1) REST API (data_service / report_query / edb_service)
#      用 refresh_token 鉴权 → access_token，自动管理
#      → 用于：招股书 PDF 下载、宏观指标 EDB
#
#   2) Python SDK (THS_BD / THS_HQ / THS_DataPool)
#      用 username/password 鉴权
#      → 用于：peers 财务/估值倍数/IPO 信息/K 线/南向资金
#      SDK 安装见: https://quantapi.10jqka.com.cn 客户端的 installiFinDPy.py
#
# 两个都配能拿到完整数据；只配 REST 时 peers 数据缺失（comparable / sentiment 降级）；
# 都不配时只能用本地招股书 PDF + akshare 公开数据。
# ============================================================================
THS_REFRESH_TOKEN=
IFIND_USERNAME=
IFIND_PASSWORD=
# access_token 缓存路径（默认 .cache/ths_access_token.json）
THS_TOKEN_CACHE=
# access_token 缓存时长（秒），默认 6 小时
THS_TOKEN_TTL=21600

# 港交所披露易（如使用付费接口需配置；公开页面爬取无需）
HKEX_API_KEY=

# 路径
DATA_DIR=./data
CACHE_DIR=./.cache
REPORTS_DIR=./reports
PROSPECTUS_DIR=./data/prospectus


# 运行参数
DEBATE_MAX_ROUNDS=2
RAG_TOP_K=6
LOG_LEVEL=INFO

# RAG embedding 模型（中文优先 BGE）
# 可选: BAAI/bge-small-zh-v1.5 (95MB) / BAAI/bge-base-zh-v1.5 (~400MB) / BAAI/bge-large-zh-v1.5 (~1.3GB)
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu

# 同花顺 QuantAPI 端点路径（一般无需改动，套餐差异时可覆盖）
THS_ENDPOINT_BASIC_DATA=basic_data_service
THS_ENDPOINT_EDB=edb_service
THS_ENDPOINT_DATA_REPORT=data_report
