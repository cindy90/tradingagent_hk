# LLM
ANTHROPIC_API_KEY=sk-ant-...

# 同花顺 iFinD API（可选，未配置时回退到 akshare）
THS_USER=
THS_PASSWORD=

# 港交所披露易（如使用付费接口需配置；公开页面爬取无需）
HKEX_API_KEY=

# 路径
DATA_DIR=./data
CACHE_DIR=./.cache
REPORTS_DIR=./reports
PROSPECTUS_DIR=./data/prospectus

# 模型分级（可覆盖默认值）
MODEL_TIER_SUMMARIZE=claude-haiku-4-5-20251001
MODEL_TIER_ANALYZE=claude-sonnet-4-6
MODEL_TIER_DECIDE=claude-opus-4-7

# 运行参数
DEBATE_MAX_ROUNDS=2
RAG_TOP_K=6
LOG_LEVEL=INFO
